// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Products {
  id          Int    @id
  flavor      String
  name        String
  price       String
  url         String
  size        String
  weight      String
  ingredients String
  description String
}

model Flavor {
  id              Int               @id @default(autoincrement())
  name            String
  sampleApplyData SampleApplyData[]
}

model SampleAmount {
  id              Int               @id @default(autoincrement())
  name            String
  sampleApplyData SampleApplyData[]
}

model SampleApplyData {
  applyID  Int          @id @default(autoincrement())
  name     String
  phone    String
  email    String
  flavorID Int
  amountID Int
  date     String
  address  String
  userID   String
  flavor   Flavor       @relation(fields: [flavorID], references: [id])
  amount   SampleAmount @relation(fields: [amountID], references: [id])
}
